{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": ["data/**", "server.ts"]
    }
  },
  "rewrites": [
    {
      "source": "/api/test",
      "destination": "/api/test.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
